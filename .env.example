# Copy to .env to override. All values below are the built-in defaults.

# API HTTP port.
PORT=4000

# Backblaze B2 (S3-compatible) — where compressed output lives.
# Create a bucket + an application key restricted to it at backblaze.com, then
# fill these in. No built-in default: the api won't start without them.
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
