# Copy to .env to override. All values below are the built-in defaults.

# Where the API and worker reach Redis (the compose.yaml service).
REDIS_URL=redis://localhost:6380

# API HTTP port.
PORT=4000

# How many jobs one worker process runs at once. Real parallelism is still
# bounded by libuv's thread pool (default 4) where sharp does its work — raising
# total throughput past that needs more worker *processes*, not a bigger number here.
WORKER_CONCURRENCY=2

# Backblaze B2 (S3-compatible) — where raw uploads and compressed output live.
# Create a bucket + an application key restricted to it at backblaze.com, then
# fill these in. No built-in default: the api and worker won't start without them.
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
